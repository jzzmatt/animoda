# Animoda environment template.
# Phase 1 does not read these values. Do not commit real secrets.

# Phase 6A — Supabase Postgres and Storage.
# NEXT_PUBLIC_ names are visible in the browser. Put only the project URL and the publishable or anon key there.
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_SECRET_KEY are server-only. Never prefix them with NEXT_PUBLIC_.
# The server accepts either naming set. Leave every value empty in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 6A report, and later the Phase 6B generation batch. Server-only.
FASHION_SAMPLE_ADMIN_TOKEN=

# Server-only image generation. Leave both empty in this file.
# OPENAI_API_KEY and OPENAI_IMAGE_MODEL (a name starting with gpt-image-) are the image provider.
# Do not prefix either name with NEXT_PUBLIC_.
# An empty key does not generate an image. Studio jobs other than the Emerald tree boa pilot
# finish as mock_completed and do not call a provider.
# A completed job requires provider output and a PNG that was saved and read back from Supabase Storage.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# These names are not the image provider. Leave both empty. Do not commit real secrets.
# A set FASHION_CONCEPT_API_KEY is not sent. That job fails and no request is made.
# A set VIRTUAL_TRY_ON_API_KEY is not sent. No composite is made.
FASHION_CONCEPT_API_KEY=
VIRTUAL_TRY_ON_API_KEY=

# Phase 3 — wildlife data. Public GBIF does not require a key.
# An iNaturalist token is only needed if that source is selected later.
# INATURALIST_API_TOKEN=
