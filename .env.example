# Animoda environment template.
# Copy this file to the gitignored `.env`. Do not commit real secrets.
# Leave credential values empty. The image model line is a supported model name, not a secret.

# Supabase Postgres and Storage.
# NEXT_PUBLIC_ names are visible in the browser. Put only the project URL and the publishable or anon key there.
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_SECRET_KEY are server-only. Never prefix them with NEXT_PUBLIC_.
# The server accepts either naming set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only image generation. Do not prefix either name with NEXT_PUBLIC_.
# OPENAI_API_KEY authenticates catalogue image generation. It is not a browser login token.
# When OPENAI_IMAGE_MODEL is empty, the server uses gpt-image-2.5-flare.
# A set value must be one of: gpt-image-2.5-sunburst, gpt-image-2.5-flare, gpt-image-2, gpt-image-1.5, gpt-image-1-mini.
# gpt-image-1 was shut down and is rejected. An invalid name fails the job and does not call a provider.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Explicit local mock. Leave empty. Set to 1 only for a labelled development job.
# A mock job does not call OpenAI and does not count as a stored catalogue sample.
ANIMODA_MOCK_GENERATION=

# Phase 3 — wildlife data. Public GBIF does not require a key.
# An iNaturalist token is only needed if that source is selected later.
# INATURALIST_API_TOKEN=
