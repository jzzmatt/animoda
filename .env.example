# Animoda environment template.
# Copy the names you need. Do not commit real secrets.

# Phase 5 — OpenAI image generation and editing. Server only.
# Leave OPENAI_API_KEY empty until this server should call OpenAI.
# An empty key fails the studio job with a configuration message. It does not call OpenAI and does not invent an image.
# OPENAI_IMAGE_MODEL is the image model. gpt-image-2.5-sunburst is the current default for precise editing.
# Set ANIMODA_IMAGE_PROVIDER=demo only for an explicit labelled demo. That mode does not call OpenAI.
# Do not put these values in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Phase 6 — Supabase Auth, Postgres, and Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 — wildlife data. Public GBIF does not require a key.
# An iNaturalist token is only needed if that source is selected later.
# INATURALIST_API_TOKEN=
